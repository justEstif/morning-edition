{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": "error",
    "no-explicit-any": "warn",
    "eqeqeq": "error",
    "no-console": "error"
  },
  "overrides": [
    {
      "files": ["scripts/**", "svelte.config.js", "vite.config.js"],
      "rules": {
        "no-console": "off"
      }
    }
  ],
  "ignorePatterns": ["build", "node_modules", "data", ".svelte-kit", "**/*.svelte"]
}
