{
  "name": "morning-edition",
  "version": "0.5.0",
  "private": true,
  "description": "The Morning Edition — SvelteKit rendering + delivery layer. The Python builder stays the source of truth for edition JSON; this app renders it and collects feedback server-side.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "oxlint . && oxfmt --check . && svelte-check --tsconfig ./tsconfig.json",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "start": "node build",
    "import-votes": "node scripts/import-votes.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/kit": "^2.20.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/node": "^22.20.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "svelte": "^5.25.0",
    "svelte-check": "^4.7.7",
    "typescript": "^5.9.3",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
